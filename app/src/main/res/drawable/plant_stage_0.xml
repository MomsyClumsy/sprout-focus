<?xml version="1.0" encoding="utf-8"?>
<!--
    Стадия 0: семя. Ещё ничего не выросло — и это нормально.

    Сетка 200x200, а не иконочные 24x24: картинка показывается размером
    от 28 до 120dp, и на мелкой сетке кривые шли ступеньками.

    Семя лежит В земле, а не на линии: нижняя часть заходит под холмик.
    Так оно читается посаженным, а не положенным сверху.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- мягкая тень: держит растение на земле, не даёт ему висеть -->
    <path
        android:pathData="M34,182 C34,177.03 63.55,173 100,173 C136.45,173 166,177.03 166,182 C166,186.97 136.45,191 100,191 C63.55,191 34,186.97 34,182 Z"
        android:fillColor="@color/plant_shadow" />

    <!-- Земля — округлый пятачок, а не линза: у линзы по краям сходятся
         две дуги, и на экране получаются два острых шипа, спорящих
         с мягкими формами растения. -->
    <path
        android:pathData="M38,177 C38,171.48 65.76,167 100,167 C134.24,167 162,171.48 162,177 C162,182.52 134.24,187 100,187 C65.76,187 38,182.52 38,177 Z"
        android:fillColor="@color/plant_soil" />
    <path
        android:pathData="M50,174 C50,170.14 72.38,167 100,167 C127.62,167 150,170.14 150,174 C150,177.86 127.62,181 100,181 C72.38,181 50,177.86 50,174 Z"
        android:fillColor="@color/plant_soil_top" />

    <group
        android:translateY="-6"
        android:rotation="-16"
        android:pivotX="100"
        android:pivotY="158">
        <path
            android:pathData="M100,132 C113,132 122,144 122,157 C122,170 113,180 100,180 C87,180 78,170 78,157 C78,144 87,132 100,132 Z"
            android:fillColor="@color/plant_seed" />
        <!-- блик, чтобы овал читался объёмным зерном -->
        <path
            android:pathData="M94,141 C101,139 107,146 108,154 C109,162 105,169 99,170 C93,171 88,165 87,157 C86,149 89,143 94,141 Z"
            android:fillColor="@color/plant_seed_hi"
            android:fillAlpha="0.75" />
    </group>
</vector>
