<?xml version="1.0" encoding="utf-8"?>
<!-- Сад: росток.
     Важно: листья касаются стебля одной точкой и расходятся в стороны.
     Если внутренний край листа идёт вертикально вдоль оси x=12, три обводки
     по 2px накладываются друг на друга и середина заплывает в пятно. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- стебель -->
    <path
        android:pathData="M12,21 L12,13.5"
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- левый лист -->
    <path
        android:pathData="M11.3,13.2 C8,14.2 4.8,12 4,8.4 C7.6,7.8 10.6,9.8 11.3,13.2 Z"
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:strokeLineJoin="round" />

    <!-- правый лист -->
    <path
        android:pathData="M12.7,12.4 C13.4,9 16.4,7 20,7.6 C19.2,11.2 16,13.2 12.7,12.4 Z"
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:strokeLineJoin="round" />
</vector>
