<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Обратный отсчёт в шторке и сигнал об окончании сессии -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Точный момент окончания сессии.
         USE_EXACT_ALARM выдаётся автоматически и предназначен как раз для
         таймеров и будильников — это основная функция экрана сессии.
         Без него Android ставит будильник с окном до 15 минут, и сигнал
         об окончании опаздывает, что для таймера равносильно поломке.
         SCHEDULE_EXACT_ALARM оставлен для Android 12 (там USE_EXACT_ALARM ещё нет). -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Будильники не переживают перезагрузку. Без этого разрешения
         напоминания молча пропадают после первого же выключения телефона —
         а приложение, которое обещало напомнить и не напомнило,
         теряет доверие один раз и насовсем. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Барьер отвлечений (этап 7).
         Оба разрешения особые: диалогом их не выдают, человек включает их
         руками в настройках системы, и приложение работает без них.

         PACKAGE_USAGE_STATS показывает только, какое приложение открыто.
         AccessibilityService дал бы то же самое проще — и заодно доступ
         ко всему содержимому чужих экранов. Приложение про доверие
         не может просить право читать переписку. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- «Не беспокоить» на время сессии. Тоже особое разрешение: объявления
         в манифесте мало, доступ к политике уведомлений человек выдаёт
         руками в настройках системы. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Чтобы показать список установленных приложений и дать выбрать
         отвлекающие. Спрашиваем только те, у которых есть значок
         в лаунчере, — этого хватает, и QUERY_ALL_PACKAGES не нужен. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SproutApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sprout">

        <!-- singleTop: уведомление открывает уже запущенное приложение,
             а не заводит вторую копию поверх первой. Намерение приходит
             в onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Sprout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".timer.SessionEndReceiver"
            android:exported="false" />

        <!-- Наступил момент напоминания -->
        <receiver
            android:name=".plan.PlanReceiver"
            android:exported="false" />

        <!-- Кнопка «Начать» в уведомлении -->
        <receiver
            android:name=".plan.PlanActionReceiver"
            android:exported="false" />

        <!-- Сторож отвлечений. Живёт только пока идёт сессия и только если
             барьер включён. Тип specialUse: узнать, какое приложение открыто
             сейчас, можно лишь опросом из живого процесса — под остальные
             типы это не подходит. -->
        <service
            android:name=".focusguard.GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Отслеживание отвлекающих приложений во время фокус-сессии" />
        </service>

        <!-- Виджет на домашний экран. exported обязателен: рисует его
             лаунчер, то есть чужой процесс. -->
        <receiver
            android:name=".widget.SproutWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sprout_widget_info" />
        </receiver>

        <!-- Расставить будильники заново. exported обязателен: события
             шлёт система, а не приложение. -->
        <receiver
            android:name=".plan.PlanBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
